import pandas as pd
import numpy as np

ap = pd.read_csv("Admission_Predict - Admission_Predict.csv")

ap

ap['Admit'] = (ap['Chance of Admit']>0.87).astype(int)
ap

ap = ap.drop(columns=['Chance of Admit','Serial No.'])
ap

ap.isna().sum()

ap= ap.fillna(ap.median(numeric_only= True))

ap.isna().sum()

from sklearn.model_selection import train_test_split
X = ap.drop(columns=['Admit'])
y= ap['Admit']

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42
)

from sklearn.tree import DecisionTreeClassifier
from sklearn.metrics import accuracy_score, confusion_matrix, precision_score,recall_score, f1_score

ap_entropy = DecisionTreeClassifier(criterion='entropy')
ap_entropy.fit(X_train, y_train)

y_pred1 = ap_entropy.predict(X_train)

confusion_matrix(y_train,y_pred1)

accuracy = accuracy_score(y_train,y_pred1)
precision = precision_score(y_train,y_pred1)
recall = recall_score(y_train,y_pred1)
f1 = f1_score(y_train,y_pred1)
print(f"Accuracy: {accuracy}")
print(f"Precision: {precision}")
print(f"Recall: {recall}")
print(f"F1 Score: {f1}")

y_pred = ap_entropy.predict(X_test)

confusion_matrix(y_test,y_pred)

accuracy = accuracy_score(y_test,y_pred)
precision = precision_score(y_test,y_pred)
recall = recall_score(y_test,y_pred)
f1 = f1_score(y_test,y_pred)
print(f"Accuracy: {accuracy}")
print(f"Precision: {precision}")
print(f"Recall: {recall}")
print(f"F1 Score: {f1}")

import matplotlib.pyplot as plt
from sklearn.tree import plot_tree
plt.figure(figsize=(15,10))
plot_tree(ap_entropy, filled=True)
plt.show()

