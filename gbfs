# Greedy Best First Search
def gbfs(graph, heuristic, start, goal)
    openlist = [start]
    closelist = []

    # To store the path
    parent = {}
    parent[start] = Non
   print("\ninitial openlist:", openlist)
    print("initial closelist:", closelist)

    while openlist:  
   # Select node with minimum heuristic value
        current = min(openlist, key=lambda node: heuristic[node])

        # Remove current node from open list
        openlist.remove(current)
        print("\n======================")
        print("current:", current)
        print("openlist:", openlist)

        # Goal test
        if current == goal:
            print("goal found")

            # Create path
            path = []
            node = goal

            while node is not None:
                path.append(node)
                node = parent[node]

            path.reverse()
           print("path:", path)
            return path

        # Add current node to closed list
        closelist.append(current)

        # Visit all neighbours
        for neighbour in graph[current]:

            if neighbour not in closelist and neighbour not in openlist
            openlist.append(neighbour)

                # Store parent
                parent[neighbour] = current
                print("added:", neighbour)
                print("openlist:", openlist)
                print("closelist:", closelist)
                print("------------------------")
   print("Goal not found")
    return None


