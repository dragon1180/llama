import pandas as pd
import numpy as np

iris = pd.read_csv('iris - iris.csv')

iris

iris.isna().sum()

from sklearn.preprocessing import LabelEncoder
le = LabelEncoder()
iris["variety"] = le.fit_transform(iris["variety"])
iris

from sklearn.model_selection import train_test_split
X = iris.drop(columns=['variety'])
y = iris['variety']

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42
)

from sklearn.neighbors import KNeighborsClassifier

knn = KNeighborsClassifier(n_neighbors=3)
knn.fit(X_train, y_train)

y_pred = knn.predict(X_train)

from sklearn.metrics import confusion_matrix
confusion_matrix(y_train, y_pred)

from sklearn.metrics import accuracy_score,precision_score,recall_score,f1_score
acc = accuracy_score(y_train, y_pred)
prec = precision_score(y_train, y_pred, average='micro')
rec = recall_score(y_train, y_pred, average='micro')
f1 = f1_score(y_train, y_pred, average='micro')

print("Accuracy:", acc)
print("Precision:", prec)
print("Recall:", rec)
print("F1 Score:", f1)

y_pred_test = knn.predict(X_test)

confusion_matrix(y_test, y_pred_test)

acc_test = accuracy_score(y_test, y_pred_test)
prec_test = precision_score(y_test, y_pred_test, average='micro')
rec_test = recall_score(y_test, y_pred_test, average='micro')
f1_test = f1_score(y_test, y_pred_test, average='micro')

print("Accuracy:", acc_test)
print("Precision:", prec_test)
