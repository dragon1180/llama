    u = input(f"Enter first node of edge {i + 1}: ")
    v = input(f"Enter second node of edge {i + 1}: ")

    graph[u].append(v)
    graph[v].append(u)  # Undirected graph


print("\nAdjacency List:")
for node in graph:
    print(node, "->", graph[node])


start = input("\nEnter the starting node: ")

print()

match choice:
    case 1:
        BFS(graph, start)
 
    case 2:
        DFS(graph, start)

    case _:
        print("Invalid choice. Please enter 1 for BFS or 2 for DFS.")
