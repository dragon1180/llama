    "flu": ["fever", "cough"],
    "cold": ["cough", "sneezing"],
    "infection": ["fever", "body_pain"],
    "pneumonia": ["fever", "cough", "breathing_problem"],
    "take_medicine": ["flu"],
    "take_rest": ["flu"]

}

known_facts = []
matching = []
ans = []
facts = []

for i in rules:
    for j in rules[i]:
        facts.append(j)

facts.append("flu")
facts.append("cold")
facts.append("infection")
facts.append("pneumonia")
facts.append("take_medicine")
facts.append("take_rest")


# -------- Forward chaining function --------
def forward(rules, known_facts):
    new_fact = True

    while new_fact:
        new_fact = False
        antecedents = known_facts[len(known_facts) - 1]

        for consequent in rules:
            if antecedents in known_facts and antecedents in rules[consequent]:
                if consequent not in known_facts:
                    print(known_facts, "->", consequent)
                    known_facts.append(consequent)
                    new_fact = True

    return known_facts[len(known_facts) - 1]


# -------- Backward chaining function --------
def backward(rules, known_facts, goal):

    if goal in known_facts:
        return True

    matching.clear()

    for i in rules:
        if goal == i:
            for j in rules[i]:
                matching.append(j)
                ans.append(j)

    if len(matching) == 0:
        return False

    for i in matching:
        istrue = True

        if i in known_facts:
            return True

        for a in rules[i]:
            ans.append(a)

            if not backward(rules, known_facts, a):
                istrue = False
                break

        if istrue:
            known_facts = goal
            return True

    return False


